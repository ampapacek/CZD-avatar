# Per-server settings for deploy/deploy.sh. Copy to deploy/deploy.env (untracked)
# and uncomment what differs from the defaults. Re-run deploy/install.sh after
# changing SERVICE, so the sudoers rule names the right service.

# Branch the server follows.
#DEPLOY_BRANCH=production

# systemd service that runs the app.
#SERVICE=czdemos.service

# Answers once the app is up.
#HEALTH_URL=http://127.0.0.1/settings

# Found on PATH or in ~/.local/bin by default.
#UV=/home/papacek/.local/bin/uv
