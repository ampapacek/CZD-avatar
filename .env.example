# Select which provider is used by default in the UI.
LLM_PROVIDER=aiufal

# Shared admin password: unlocks the full model list in the browser and
# authorizes modifying/deleting shared prompt presets owned by another browser.
ADMIN_PASSWORD=

# Discovered provider model lists are cached for this many seconds. The same TTL
# covers discovered context windows and reasoning support.
LLM_MODELS_CACHE_TTL_SECONDS=3600

# Timeout shared by answer generation, conversation summarisation, and the
# optional conversation retrieval-query rewrite.
LLM_TIMEOUT_SECONDS=120

# Reasoning support (which effort levels a model takes, and whether it can be
# turned off) and context length are read from the provider's own model
# catalogue in one pass, where the provider publishes them. Only OpenRouter
# does, so only OpenRouter is asked by default; set
# LLM_PROVIDER_<ID>_DISCOVER_CATALOG=true/false to override per provider.
# Anything a provider does not publish is declared by hand in data/models.json,
# which also overrides discovery when a catalogue turns out to be wrong.
# A discovered context length is capped by the provider's own context_window in
# data/models.json, so discovery can only ever reveal that a model is smaller
# than assumed. Set max_context_window on the provider there to use the bigger
# windows on purpose.

# Provider ids are free-form env-safe tokens.
LLM_PROVIDERS=aiufal,openrouter,einfra

# AI Ufal
LLM_PROVIDER_AIUFAL_NAME=AI Ufal
LLM_PROVIDER_AIUFAL_BASE_URL=https://ai.ufal.mff.cuni.cz/api
LLM_PROVIDER_AIUFAL_API_KEY=
LLM_PROVIDER_AIUFAL_DEFAULT_MODEL=LLM1-A40.llama3.3:latest
LLM_PROVIDER_AIUFAL_PUBLIC_MODELS=*
LLM_PROVIDER_AIUFAL_MODELS=
LLM_PROVIDER_AIUFAL_MODELS_URL=
LLM_PROVIDER_AIUFAL_DISCOVER_MODELS=true
LLM_PROVIDER_AIUFAL_SUPPORTS_STREAMING=true
LLM_PROVIDER_AIUFAL_API_KEY_LABEL=AI Ufal API key

# OpenRouter
LLM_PROVIDER_OPENROUTER_NAME=OpenRouter
LLM_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER_OPENROUTER_API_KEY=
LLM_PROVIDER_OPENROUTER_DEFAULT_MODEL=openrouter/free
LLM_PROVIDER_OPENROUTER_PUBLIC_MODELS=openrouter/free
LLM_PROVIDER_OPENROUTER_MODELS=openrouter/free
LLM_PROVIDER_OPENROUTER_MODELS_URL=
LLM_PROVIDER_OPENROUTER_DISCOVER_MODELS=true
LLM_PROVIDER_OPENROUTER_DISCOVER_CATALOG=true
LLM_PROVIDER_OPENROUTER_SUPPORTS_STREAMING=true
LLM_PROVIDER_OPENROUTER_API_KEY_LABEL=OpenRouter API key

# e-infra / MetaCentrum
LLM_PROVIDER_EINFRA_NAME=e-infra
LLM_PROVIDER_EINFRA_BASE_URL=https://llm.ai.e-infra.cz/v1
LLM_PROVIDER_EINFRA_API_KEY=
LLM_PROVIDER_EINFRA_DEFAULT_MODEL=mini
LLM_PROVIDER_EINFRA_PUBLIC_MODELS=*
LLM_PROVIDER_EINFRA_MODELS=
LLM_PROVIDER_EINFRA_MODELS_URL=
LLM_PROVIDER_EINFRA_MODEL_INFO_URL=
LLM_PROVIDER_EINFRA_DISCOVER_MODELS=true
LLM_PROVIDER_EINFRA_SUPPORTS_STREAMING=true
LLM_PROVIDER_EINFRA_API_KEY_LABEL=e-infra API key

QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=czech_history_chunks

EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=10
MIN_SCORE=0.2
MIN_RELATIVE_SCORE=0.3
CONTEXT_WINDOW_TOKENS=32768
OUTPUT_TOKEN_BUDGET_SHORT=384
OUTPUT_TOKEN_BUDGET_MEDIUM=768
OUTPUT_TOKEN_BUDGET_LONG=1024
MIN_PROMPT_CHUNKS=3
TOKEN_BUDGET_SAFETY_MARGIN=0.10
# Conversation compaction: the token trigger is the smaller of the configured
# maximum and 250 + 25% of the usable model input. Compaction also fires after
# the message-count trigger. Up to CONVERSATION_RECENT_MESSAGES recent messages
# are kept verbatim; older messages are folded into a rolling summary.
CONVERSATION_SUMMARY_TRIGGER_TOKENS=8000
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=16
CONVERSATION_RECENT_MESSAGES=6
# Long messages are retrieved directly instead of first being sent through an
# extra LLM query-rewrite call. Retrieval itself remains enabled.
CONVERSATION_QUERY_REWRITE_MAX_TOKENS=1024
RETRIEVAL_BACKEND=msearch

# Cross-encoder reranking (applied after retrieval, before token-budget trimming).
# Disabled by default; enable via the UI weight slider or RERANKER_WEIGHT>0.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_WEIGHT=0.0
RERANKER_CANDIDATES=40

MSEARCH_BASE_URL=https://api.msearch.themama.ai
MSEARCH_USERNAME=
MSEARCH_PASSWORD=
MSEARCH_COLLECTION=64d6f521-5044-4b02-8658-380b639801af
MSEARCH_MAX_RESULTS=10
MSEARCH_MODE=hybrid
MSEARCH_MIN_CONFIDENCE=0
MSEARCH_TIMEOUT=60

RAW_DATA_DIR=data/raw
CHUNK_CATALOG_PATH=data/processed/chunks.jsonl
# Gitignored mutable overlays; may be absent on a fresh deploy. Built-in prompts
# and placeholder defaults ship in code (app/rag/wp_config.py, app/rag/placeholders.py).
PROMPT_PRESETS_PATH=data/prompt_presets.json
PLACEHOLDERS_PATH=data/placeholders.json

# Privacy-minimized usage analytics. One JSON object per event, rotated monthly.
ANALYTICS_ENABLED=true
ANALYTICS_DIR=logs/events
ANALYTICS_INSTANCE_ID=czd-avatar
